# Server-only access to the shared jobs backend for this independent site.
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>

# Per-site canonical domain (overrides the code-level fallback in app/layout.tsx etc.)
NEXT_PUBLIC_SITE_URL=https://zimmermannjob.ch

# Privacy-first default. Enable measurement only after the responsible
# controller and public privacy information have been completed and reviewed.
ANALYTICS_ENABLED=false

# Optional: UI/metadata staleness threshold for the latest scrape timestamp. Default 72.
SCRAPE_STALE_HOURS=72

# Application intake is fail-closed unless the controller, exact origin and
# server-only abuse-prevention settings below are configured.
APPLICATIONS_ENABLED=false
APPLICATIONS_ALLOWED_ORIGIN=https://zimmermannjob.ch
APPLICATIONS_CONTROLLER_NAME=<legal controller name>
APPLICATIONS_CONTROLLER_ADDRESS=<postal address>
APPLICATIONS_CONTROLLER_EMAIL=<privacy contact email>
APPLICATIONS_CONSENT_VERSION=2026-08-19
APPLICATIONS_RETENTION_DAYS=90
APPLICATIONS_IP_HASH_SECRET=<at least 32 random characters>
APPLICATIONS_RATE_LIMIT_MAX=3
APPLICATIONS_RATE_LIMIT_WINDOW_MINUTES=60
