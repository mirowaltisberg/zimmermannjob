{
  "name": "zimmermannjob",
  "version": "0.3.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:public-jobs": "tsx scripts/check-public-jobs.ts",
    "check:raw-job-boundary": "NODE_PATH=./node_modules/next/dist/compiled node --conditions=react-server --import tsx --test src/lib/scraped-jobs.test.ts",
    "check:direct-hire-boundary": "node --import tsx --test src/lib/direct-hire-opportunities.test.ts",
    "check:job-safety:python": "python3 scripts/check_job_safety.py",
    "check:publisher-boundary": "python3 scripts/check_publisher_boundary.py",
    "check:workflow-boundary": "python3 scripts/check_workflow_boundary.py",
    "check:job-safety": "npm run check:public-jobs && npm run check:raw-job-boundary && npm run check:direct-hire-boundary && npm run check:job-safety:python && npm run check:publisher-boundary && npm run check:workflow-boundary",
    "check:live-public-jobs": "tsx scripts/check-live-public-jobs.ts",
    "scrape": "scripts/.venv/bin/python scripts/scrape-jobs.py",
    "scrape:quick": "scripts/.venv/bin/python scripts/scrape-jobs.py --quick"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.5.0",
    "web-haptics": "^0.0.6"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
